
    @{
        ViewData["title"] = "Photos Page";
    }

<div class="page-navigation">
    <a asp-controller="BD" asp-action="SpecialMoments" class="next-page-btn">
        <span>Next</span><span class="next-arrow">→</span>
    </a>
</div>

    <!-- Photo Gallery Section -->
    <section id="gallery" class="gallery-section">
        <div class="container">
        <div class="page-heading"> <p class="eyebrow">Chapter 02 — just for someone special</p> 
            <h1 class="section-title">You Make These Memories Beautiful</h1> 
            <p>These may just be photos, but for me, they are little reminders of the moments we shared and of how special you are to me. ❤️</p> </div>
            <div class="gallery-controls">
                <button class="gallery-btn" id="gridViewBtn">Grid View</button>
                <button class="gallery-btn" id="slideshowViewBtn">Slideshow</button>
            </div>

            <!-- Grid View -->
            <div class="gallery-grid" id="galleryGrid">
            <button type="button" class="gallery-item" data-caption="A beautiful moment with you ❤️">
                <img src="~/Images/Img20250402131104.jpg" alt="Birthday celebration" />
                  
                    <div class="gallery-overlay">
                    <h3>You Are Special</h3>
                    <p>You make every moment feel beautiful.</p>
                    </div>
                </button>

            <button type="button" class="gallery-item" data-caption="A little memory with my favourite person">
                <img src="~/Images/Photos2.jpeg" alt="Birthday celebration" />
                    <div class="gallery-overlay">
                    <h3>Being With You</h3>
                    <p>Every moment with you means something to me.</p>
                    </div>
                </button>
            <button type="button" class="gallery-item" data-caption="A moment I will always keep">
                <img src="~/Images/Photos3.jpeg" alt="Birthday celebration" />
                    <div class="gallery-overlay">
                    <h3>Your Smile</h3>
                    <p>Your smile makes everything brighter.</p>
                    </div>
                </button>
            <button type="button" class="gallery-item" data-caption="Just seeing you happy is enough ❤️">
                <img src="~/Images/Photos4.jpeg" alt="Birthday celebration" />
                    <div class="gallery-overlay">
                    <h3>Your Happiness</h3>
                    <p>I always want to see you smiling.</p>
                    </div>
                </button>
            <button type="button" class="gallery-item" data-caption="A beautiful memory with someone truly special">
                <img src="~/Images/Photos5.jpg" alt="Birthday celebration" />
                    <div class="gallery-overlay">
                    <h3>My Special Person</h3>
                    <p>You are more special than you know.</p>
                    </div>
                </button>
            <button type="button" class="gallery-item" data-caption="A little reminder for you ❤️">
                <img src="~/Images/Photos6.jpeg" alt="Birthday celebration" />
                    <div class="gallery-overlay">
                    <h3>Always Remember</h3>
                    <p>Never forget how amazing and special you are.</p>
                    </div>
                </button>
            </div>

            <!-- Slideshow View -->
            <div class="gallery-slideshow" id="gallerySlideshow" style="display: none;">
                <div class="slideshow-container">
                    <div class="slide active">

                    <img src="~/Images/Photos1.jpg" alt="Birthday celebration">
                    <div class="slide-caption">A beautiful moment with you ❤️</div>
                    </div>
                    <div class="slide">
                    <img src="~/Images/Photos2.jpeg" alt="Birthday ">
                    <div class="slide-caption">A little memory with my favourite person</div>
                    </div>
                    <div class="slide">
                    <img src="~/Images/Photos3.jpeg" alt="Friends celebrating">
                    <div class="slide-caption">A moment I will always keep</div>
                    </div>
                </div>
                <button class="slide-btn prev" id="prevSlideBtn">❮</button>
                <button class="slide-btn next" id="nextSlideBtn">❯</button>
                <div class="slide-indicators">
                    <span class="indicator active" data-slide="0"></span>
                    <span class="indicator" data-slide="1"></span>
                    <span class="indicator" data-slide="2"></span>
                </div>
            </div>
        </div>
    </section>

<dialog class="photo-modal" id="photoModal">
    <button class="modal-close" type="button" aria-label="Close photo">×</button>
    <img id="modalImage" src="" alt="Selected memory" />
    <p id="modalCaption"></p>
</dialog>
